{
  // Configuração da hospedagem Origyn na Cloudflare (Workers + D1).
  // Valores secretos NÃO ficam aqui: META_TOKEN_ENCRYPTION_KEY é cadastrada como
  // segredo no painel da Cloudflare (Workers > origyn > Settings > Variables and Secrets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origyn",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Coleta de comentários + classificação a cada 15 minutos.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "origyn-db",
      "database_id": "40a93313-a135-4924-8be0-408140197ead",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://origyn.daniel-hos1994.workers.dev",
    "OWNER_EMAIL": "daniel.hos1994@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "shiny-fire-dd24.cloudflareaccess.com",
    "CF_ACCESS_AUD": "9603d0fda66c02e0d6ef2845294478e74a991340428557e3bf9bb6deabd55a10",
    "META_APP_ID": "1729049365059188",
    "META_LOGIN_CONFIG_ID": "1721088988958270",
    "CLAUDE_MODEL": "claude-haiku-5-5"
  }
}
